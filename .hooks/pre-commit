#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
export PATH="${XDG_BIN_HOME:-$HOME/.local/bin}:$PATH"
files=()
mapfile -d '' files < <(git diff --cached --name-only --diff-filter=ACMR -z)
if ((${#files[@]} == 0)); then
  exit 0
fi
command -v gitleaks >/dev/null || { echo "Install pinned gitleaks before committing" >&2; exit 127; }
command -v lizard >/dev/null || { echo "Install pinned lizard before committing" >&2; exit 127; }
gitleaks git --staged --redact --no-banner "$root"
code=()
for file in "${files[@]}"; do
  case "$file" in
    *.py|*.js|*.jsx|*.ts|*.tsx|*.rs|*.go|*.cs) [[ -f "$file" ]] && code+=("$file") ;;
  esac
done
if ((${#code[@]})); then
  output="$(cd "$root" && lizard -C 10 -w "${code[@]}" 2>&1 || true)"
  [[ -z "$output" ]] || { printf '%s\n' "$output" >&2; exit 1; }
fi
